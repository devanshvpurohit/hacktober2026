  "firmware_code": "#include <DHT.h>\n#include <AdafruitUnifiedSensor.h>\n#include <Servo.h>\n#include <Wire.h>\n#include <Potentiometer.h>\n\n#define DHTPIN 4\n#define DHTTYPE DHT22\n\nDHT dht(DHTPIN, DHTTYPE);\nServo myservo;\nPotentiometer potentiometer_10k(0, 0, 1023);\n\nvoid setup() {\n  Serial.begin(115200);\n  dht.begin();\n  myservo.attach(9);\n  potentiometer_10k.attach(5);\n}\n\nvoid loop() {\n  float t = dht.readTemperature(DHTTYPE);\n  float h = dht.readHumidity();\n  if (isnan(t) || isnan(h)) {\n    Serial.println(\"Failed to read from DHT sensor!\");\n    return;\n  }\n  float tempC = t * 9/5 + 32;\n  if (tempC > 30) {\n    myservo.write(180);\n  } else {\n    myservo.write(0);\n  }\n  Serial.print(\"Temp: \");\n  Serial.print(tempC);\n  Serial.println(\" C\");\n  Serial.println(\"\");\n  delay(2000);\n}",
