  "firmware_code": "/*\n * Auto-generated by CircuitForge AI (Deterministic Catalog Generator)\n * Project: ESP32 OLED Display with WiFi\n */\n#include <Arduino.h>\n#include <DHT.h>\n\n#define DHTPIN 4\n#define DHTTYPE DHT22\n#define LED_PIN 2\n\nconst float TEMP_THRESHOLD = 30.0;\nDHT dht(DHTPIN, DHTTYPE);\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(LED_PIN, OUTPUT);\n  digitalWrite(LED_PIN, LOW);\n  dht.begin();\n  Serial.println(F(\"CircuitForge AI - ESP32 Temperature Monitor Initialized\"));\n}\n\nvoid loop() {\n  delay(2000);\n  float t = dht.readTemperature();\n  float h = dht.readHumidity();\n\n  if (isnan(t) || isnan(h)) {\n    Serial.println(F(\"[ERROR] Failed to read from DHT22 sensor\"));\n    return;\n  }\n\n  Serial.print(F(\"Temperature: \"));\n  Serial.print(t, 1);\n  Serial.print(F(\" °C  |  Humidity: \"));\n  Serial.print(h, 1);\n  Serial.println(F(\" %\"));\n\n  if (t > TEMP_THRESHOLD) {\n    digitalWrite(LED_PIN, HIGH);\n  } else {\n    digitalWrite(LED_PIN, LOW);\n  }\n}\n",
